{
  "name": "cbz-reader",
  "version": "1.0.1",
  "description": "A desktop app for reading .cbz comic book files.",
  "main": "electron/main.js",
  "author": "kartikay633",
  "license": "MIT",
  "homepage": "https://github.com/kartikay633/cbz-reader",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "io.github.kartikay633.cbzreader",
    "productName": "CBZ Reader",
    "files": [
      "electron/**",
      "src/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "cbz",
        "name": "Comic Book Archive",
        "description": "Comic book archive",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CBZ-Reader-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    }
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
